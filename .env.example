ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=10080
ALLOWED_ORIGINS=
ALLOW_STUDENT_REGISTRATION=true
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=CHANGE_THIS_TEACHER_PASSWORD
TEACHER_NAME=Giáo viên Vật lí
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_NAME=Quản trị viên

# Hybrid AI provider
LLM_ENABLED=true
AI_PROVIDER=gemini

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=12
GEMINI_MAX_RETRIES=1

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=12
OPENAI_MAX_RETRIES=1

LLM_MAX_OUTPUT_TOKENS=500
LLM_MIN_REASONING_CHARS=8
LLM_MAX_CONFIDENCE_BOOST=10
